///|
fn main {
  let image = @caliper.make_demo_part()
  let pixel_gap = @caliper.gauge_width(
    image,
    @caliper.Point::Point(x=10.0, y=20.0),
    @caliper.Point::Point(x=70.0, y=20.0),
  )
  let scale = @caliper.calibration_from_reference(pixel_gap, 22.0)
  let tol = @caliper.Tolerance::Tolerance(
    nominal=22.0,
    lower=21.8,
    upper=22.2,
    unit="mm",
  )
  let m = @caliper.analyze_gap("outer width", pixel_gap, scale, tol)
  let report : @caliper.MeasurementReport = {
    part_id: "demo-bracket-A",
    measurements: [m],
    notes: ["synthetic image generated by the demo fixture"],
  }
  println(@caliper.render_markdown_report(report))
}
